{
  "name": "rebar-repair",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/i18n-check.mjs && node scripts/release-check.mjs && tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "check:funcs": "npx vercel build && node scripts/check-funcs.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^3.2.24",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
